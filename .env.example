# --- LLM ---
# The model id picks the provider: an id with a slash is an OpenRouter route,
# a bare id goes to the Anthropic API directly. Claude enforces JSON schemas
# server-side on the direct path and does not through OpenRouter, so the agents
# whose output is schema-critical use bare ids.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=                    # only needed while any bare (Anthropic) id is in use
MODEL_REASONING=claude-sonnet-5       # Director, Strategist, Critic, Campaign Reviewer
MODEL_FAST=google/gemini-2.5-flash    # Source Analyst map pass, cheap bulk work
MODEL_VISION=claude-sonnet-5          # Clip frame inspection; video sources only

# Development only: when set, every role above resolves to this one model.
# Must accept images, or the Clip Producer's vision pass breaks on video sources.
# Leave empty for real runs and demos.
MODEL_OVERRIDE_ALL=

# --- Transcription ---
GROQ_API_KEY=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=    # server + worker only, never shipped to the browser

# --- Local media ---
STORAGE_DIR=./storage         # source uploads and render scratch space
# Homebrew's regular ffmpeg omits libass. Phase 5 needs ffmpeg-full to burn ASS captions.
FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
FFPROBE_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe

# --- Guardrails ---
MAX_REVISIONS_PER_ASSET=3
MAX_CAMPAIGN_REPLANS=2
MAX_ASSETS=6
DEFAULT_CREDIT_BUDGET=24
CAMPAIGN_COST_CEILING_USD=3.00
